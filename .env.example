# Copy to .env (or set these in your host's dashboard) and adjust.

# Port and bind host. Use 0.0.0.0 when running behind a reverse proxy / in a container.
PORT=3000
HOST=127.0.0.1

# First admin account (created on first run if it does not exist).
# CHANGE THESE before deploying publicly.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign session tokens. Set a long random value in production
# so sessions stay valid across restarts and deploys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Set to 1 when served over HTTPS so the session cookie is marked Secure.
SECURE_COOKIES=0
